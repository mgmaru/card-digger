{
  "schemaVersion": 2,
  "search": {
    "keyword": "ポケカ 引退品",
    "status": "on_sale",
    "sort": {
      "field": "created_time",
      "order": "asc"
    },
    "category": null,
    "minPriceYen": null,
    "maxPriceYen": null,
    "authMode": "anonymous",
    "locale": "ja-JP",
    "timezone": "Asia/Tokyo"
  },
  "collection": {
    "minimumUniqueItemCount": 100,
    "maximumUniqueItemCount": 1000,
    "maximumPageCount": 20,
    "itemDetailSampleSize": 20,
    "sellerSampleSize": 10,
    "oldListingAgeDays": 365
  },
  "imageFetch": {
    "sampleSize": 20,
    "method": "GET",
    "authMode": "anonymous",
    "timeoutSeconds": 30,
    "followRedirects": true,
    "maximumRedirectCount": 5,
    "acceptedHttpStatusMinimum": 200,
    "acceptedHttpStatusMaximum": 299,
    "minimumBodyBytes": 1,
    "maximumBodyBytes": 20971520,
    "requireDecode": true,
    "allowSessionAssistedSupplementaryTest": true,
    "allowedContentTypePrefixes": [
      "image/"
    ],
    "decodableFormats": [
      "jpeg",
      "png",
      "webp",
      "gif",
      "avif"
    ]
  },
  "sellerListings": {
    "statuses": [
      "on_sale",
      "sold_out"
    ],
    "targetUniqueItemCountPerStatus": 20,
    "maximumUniqueItemCountPerStatus": 100,
    "maximumPageCountPerStatus": 5
  },
  "stability": {
    "searchTrialCount": 5,
    "attemptTimeoutSeconds": 60,
    "automaticRetryCount": 0,
    "concurrency": 1,
    "minimumRequestIntervalSeconds": 2,
    "consecutiveSafetyErrorLimit": 3
  },
  "acceptance": {
    "minimumSearchSuccessRate": 0.8,
    "minimumRequiredFieldCoverage": 1.0,
    "minimumImageUrlCoverage": 0.95,
    "minimumImageBodyFetchCoverage": 0.95,
    "minimumCreatedAtCoverage": 0.95,
    "minimumItemConditionCoverage": 0.95,
    "minimumLikeCountCoverage": 0.95,
    "minimumSellerIdCoverage": 0.95,
    "minimumSellerNameCoverage": 0.9,
    "minimumSellerListingEndpointSuccessRatePerStatus": 0.9
  }
}
